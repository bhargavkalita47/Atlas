{
  "name": "@atlas/react",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vector": {
      "types": "./dist/vector.d.ts",
      "import": "./dist/vector.js"
    },
    "./vector-config": {
      "types": "./dist/vectorConfig.d.ts",
      "import": "./dist/vectorConfig.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --clean && tsup src/vector.ts src/vectorConfig.ts --format esm --dts",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlas/core": "0.1.0",
    "leaflet": "^1.9.4",
    "@atlas/style-core": "0.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "maplibre-gl": "^6.3.0"
  },
  "devDependencies": {
    "vitest": "^3.2.4",
    "maplibre-gl": "^6.3.0"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    }
  },
  "sideEffects": false
}
