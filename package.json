{
  "name": "atlas-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "npm run dev --workspace=atlas-playground",
    "build": "npm run build --workspace=@atlas/core && npm run build --workspace=@atlas/react && npm run build --workspace=atlas-playground",
    "test": "npm run test --workspace=@atlas/core",
    "check": "npm run build && npm run test",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.45.0"
  }
}